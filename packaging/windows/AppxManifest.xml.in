<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package manifest. build-msix.ps1 fills the placeholders:
  @IDENTITY_NAME@ and @PUBLISHER_DISPLAY_NAME@ from identity.psd1, which holds
  what Partner Center assigned at the reservation; @PUBLISHER@, the account's
  X.500 string, from STORE_PUBLISHER; and @VERSION_APPX@ from version.sh in
  its appx spelling, four parts with the fourth 0, which the Store requires.

  One file-type association, for .parquet, with its own name and icon: Windows
  registers nothing for the extension, so without them Explorer shows a
  generic file. A packaged association adds itself to OpenWithProgids and never
  takes the extension's default.

  runFullTrust and no other capability: Parkett makes no network call and
  reads only the files a person opens.

  The two resource languages must agree with makepri's /dq in build-msix.ps1,
  en-US_de-DE, or the index has no default language.

  Author: David M. Anderson
  Built with AI assistance (Claude, Anthropic)
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION_APPX@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Parkett</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>View Apache Parquet files: a grid that scrolls through millions of rows, and what the file says about itself. Copy as tab-separated rows, export as CSV.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="de-de" />
  </Resources>

  <Applications>
    <Application
      Id="Parkett"
      Executable="parkett.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Parkett"
        Description="View Apache Parquet files."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="parquet">
            <uap:DisplayName>Apache Parquet file</uap:DisplayName>
            <uap:Logo>Assets\parquet.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/vnd.apache.parquet">.parquet</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
